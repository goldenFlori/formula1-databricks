    {
      "name": "0b175b29",
      "displayName": "dominant_drivers",
      "query": "WITH driver_metrics AS\n\n(\n\nSELECT driver_name,\n\n    SUM(race_starts) AS race_starts,\n\n    SUM(number_of_wins) AS total_wins,\n\n    SUM(number_of_podiums) AS total_podiums,\n\n    SUM(CASE WHEN standing = 1 THEN 1 ELSE 0 END) AS total_championships\n\nFROM formula1.gold.v_driver_standing\n\nGROUP BY driver_name\n\nHAVING total_championships>=1\n\n)\n\nSELECT driver_name,\n\nrace_starts,\n\ntotal_wins,\n\ntotal_podiums,\n\ntotal_championships,\n\n(total_championships*100)+(total_wins*10)+(total_podiums*3) AS greatness_score\n\nFROM driver_metrics\n\nORDER BY greatness_score DESC\n\nLIMIT 10",
      "tables": ["formula1.gold.v_driver_standing"],
      "cteExpressions": ["driver_metrics"]
    },
    {
      "name": "f3dcb62b",
      "displayName": "dominant_constructors",
      "query": "WITH constructor_metrics AS\n\n(\n\nSELECT constructor_name,\n\n    SUM(race_starts) AS race_starts,\n\n    SUM(number_of_wins) AS total_wins,\n\n    SUM(number_of_podiums) AS total_podiums,\n\n    SUM(CASE WHEN standing = 1 THEN 1 ELSE 0 END) AS total_championships\n\nFROM formula1.gold.v_constructor_standing\n\nGROUP BY constructor_name\n\nHAVING total_championships>=1\n\n)\n\nSELECT constructor_name,\n\nrace_starts,\n\ntotal_wins,\n\ntotal_podiums,\n\ntotal_championships,\n\n(total_championships*100)+(total_wins*10)+(total_podiums*3) AS greatness_score\n\nFROM constructor_metrics\n\nORDER BY greatness_score DESC\n\nLIMIT 10",
      "tables": ["formula1.gold.v_constructor_standing"],
      "cteExpressions": ["constructor_metrics"]
    }
  ],
