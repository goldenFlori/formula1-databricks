# Copy to .env and replace all values before restore

WORKSPACE_HOST=https://<your-workspace-host>
BUNDLE_TARGET=dev

FORMULA1_STORAGE_URL=abfss://formula1@<your-storage-account>.dfs.core.windows.net
FORMULA1_INCR_STORAGE_URL=abfss://formula1-incr@<your-storage-account>.dfs.core.windows.net

FORMULA1_EXTERNAL_LOCATION=databricks_course_ext_dl999_formula1
FORMULA1_INCR_EXTERNAL_LOCATION=databricks_course_ext_dl999_formula1_incr
STORAGE_CREDENTIAL_NAME=<your-storage-credential>

FORMULA1_CATALOG=formula1
FORMULA1_INCR_CATALOG=formula1_incr

LANDING_VOLUME_NAME=files

# Optional backup/export target for table snapshots
BACKUP_ROOT_URL=abfss://formula1-backups@<your-storage-account>.dfs.core.windows.net
