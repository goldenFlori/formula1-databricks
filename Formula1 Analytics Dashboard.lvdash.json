{
  "datasets": [
    {
      "name": "0b175b29",
      "displayName": "dominant_drivers",
      "queryLines": [
        "WITH driver_metrics AS (\n",
        "  SELECT\n",
        "    driver_name,\n",
        "    SUM(race_starts) AS race_starts,\n",
        "    SUM(number_of_wins) AS total_wins,\n",
        "    SUM(number_of_podiums) AS total_podiums,\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN standing = 1 THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    ) AS total_championships\n",
        "  FROM\n",
        "    formula1.gold.v_driver_standing\n",
        "  GROUP BY\n",
        "    driver_name\n",
        "  HAVING\n",
        "    total_championships >= 1\n",
        ")\n",
        "SELECT\n",
        "  driver_name,\n",
        "  race_starts,\n",
        "  total_wins,\n",
        "  total_podiums,\n",
        "  total_championships,\n",
        "  (total_championships * 100) + (total_wins * 10) + (total_podiums * 3) AS greatness_score\n",
        "FROM\n",
        "  driver_metrics\n",
        "ORDER BY\n",
        "  greatness_score DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "f3dcb62b",
      "displayName": "dominant_constructors",
      "queryLines": [
        "WITH constructor_metrics AS (\n",
        "  SELECT\n",
        "    constructor_name,\n",
        "    SUM(race_starts) AS race_starts,\n",
        "    SUM(number_of_wins) AS total_wins,\n",
        "    SUM(number_of_podiums) AS total_podiums,\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN standing = 1 THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    ) AS total_championships\n",
        "  FROM\n",
        "    formula1.gold.v_constructor_standing\n",
        "  GROUP BY\n",
        "    constructor_name\n",
        "  HAVING\n",
        "    total_championships >= 1\n",
        ")\n",
        "SELECT\n",
        "  constructor_name,\n",
        "  race_starts,\n",
        "  total_wins,\n",
        "  total_podiums,\n",
        "  total_championships,\n",
        "  (total_championships * 100) + (total_wins * 10) + (total_podiums * 3) AS greatness_score\n",
        "FROM\n",
        "  constructor_metrics\n",
        "ORDER BY\n",
        "  greatness_score DESC\n",
        "LIMIT 10"
      ]
    },
